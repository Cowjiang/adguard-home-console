{
  "name": "adguard-home-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.mjs",
    "dev:all": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev\"",
    "build": "vite build",
    "check": "tsc --noEmit",
    "start": "node server/index.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "ios:build": "./scripts/ios-signing.sh tauri build --target aarch64",
    "ios:clean": "find src-tauri/gen/apple/Externals -name '*.a' -delete && rm -rf ~/Library/Developer/Xcode/DerivedData/adguard-home-console-* src-tauri/target/aarch64-apple-ios",
    "ios:deploy": "./scripts/ios-deploy.sh"
  },
  "dependencies": {
    "@sosweetham/tauri-plugin-system-components-api": "^0.1.8",
    "@tauri-apps/api": "^2.11.1",
    "express": "^4.21.2",
    "lucide-react": "latest",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "swr": "^2.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.11.5",
    "@types/express": "^4.17.21",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "concurrently": "^9.1.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "latest"
  },
  "author": "Cowjiang (https://github.com/Cowjiang)",
  "license": "SEE LICENSE IN LICENSE"
}
