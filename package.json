{
  "name": "agh-console",
  "version": "0.1.0",
  "description": "Web console for AdGuard Home: one Node process serves the UI and reverse-proxies the AdGuard Home API.",
  "type": "module",
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "agh-console": "server/index.mjs"
  },
  "files": [
    "dist",
    "server",
    "!server/*.test.mjs"
  ],
  "keywords": [
    "adguard",
    "adguard-home",
    "agh",
    "adblock",
    "ad-blocker",
    "dns",
    "self-hosted",
    "dashboard",
    "tauri"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cowjiang/adguard-home-console.git"
  },
  "homepage": "https://github.com/Cowjiang/adguard-home-console#readme",
  "bugs": {
    "url": "https://github.com/Cowjiang/adguard-home-console/issues"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.mjs",
    "dev:all": "concurrently -k -n server,web -c blue,green \"pnpm run dev:server\" \"pnpm run dev\"",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:server": "node --test 'server/*.test.mjs'",
    "test:release": "node scripts/release-plan.mjs --self-test",
    "check:pack": "node scripts/check-npm-pack.mjs",
    "start": "node server/index.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "ios:build": "./scripts/ios-signing.sh tauri build --target aarch64",
    "ios:clean": "find src-tauri/gen/apple/Externals -name '*.a' -delete && rm -rf ~/Library/Developer/Xcode/DerivedData/adguard-home-console-* src-tauri/target/aarch64-apple-ios",
    "ios:deploy": "./scripts/ios-deploy.sh"
  },
  "dependencies": {
    "@sosweetham/tauri-plugin-system-components-api": "^0.1.8",
    "@tauri-apps/api": "^2.11.1",
    "express": "^4.21.2",
    "i18next": "^26.4.2",
    "lucide-react": "latest",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.0.0",
    "swr": "^2.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.11.5",
    "@types/express": "^4.17.21",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "concurrently": "^9.1.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "latest",
    "vitest": "^5.0.3"
  },
  "author": "Cowjiang (https://github.com/Cowjiang)",
  "license": "SEE LICENSE IN LICENSE"
}
